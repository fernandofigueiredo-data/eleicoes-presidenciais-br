		formatString: +#,0;-#,0;0
		displayFolder: 5. Comparação entre turnos
		lineageTag: 60279a4a-d020-41e1-8588-c04fd89d38be

	measure '% Votos Válidos 1º Turno' =
			VAR anoAtual = [Ano Selecionado]
			RETURN
			    CALCULATE (
