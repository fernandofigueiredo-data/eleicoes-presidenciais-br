	measure 'Variação entre Turnos p.p.' =
			VAR primeiro = [% Votos Válidos 1º Turno]
			VAR segundo = [% Votos Válidos 2º Turno]
			RETURN
			    IF ( NOT ISBLANK ( primeiro ) && NOT ISBLANK ( segundo ), ( segundo - primeiro ) * 100 )
		formatString: +0.0" p.p.";-0.0" p.p.";0.0" p.p."
		displayFolder: 5. Comparação entre turnos
		lineageTag: 8b70dd1f-d085-4b8f-a0e3-92db88d28d5a

	measure 'Municípios' = CALCULATE ( DISTINCTCOUNT ( dMunicipio[cd_municipio_tse] ), dMunicipio[exterior] = FALSE () )
		formatString: #,0
		displayFolder: 6. Perfil dos municípios
		lineageTag: acf8088c-3081-4f06-9598-e3c64753e4c9

	measure 'População 2022' = SUM ( dMunicipio[populacao_2022] )
		formatString: #,0
		displayFolder: 6. Perfil dos municípios
		lineageTag: 44b914fc-506f-4415-814d-7535384423ce

	measure 'PIB per capita' =
			-- PIB total / população total (e não a média dos PIB per capita).
			-- Soma de (PIB per capita × população) = PIB total, contando só municípios com PIB.
			DIVIDE (
			    SUMX ( dMunicipio, dMunicipio[pib_per_capita] * dMunicipio[populacao_2022] ),
			    CALCULATE ( SUM ( dMunicipio[populacao_2022] ), NOT ISBLANK ( dMunicipio[pib_per_capita] ) )
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: 6. Perfil dos municípios
		lineageTag: 447e33d1-ef23-46bb-92fe-261ef8ada52a

	measure 'Alfabetização' =
			DIVIDE (
			    SUMX ( dMunicipio, dMunicipio[alfabetizacao_2022] * dMunicipio[populacao_2022] ),
			    CALCULATE ( SUM ( dMunicipio[populacao_2022] ), NOT ISBLANK ( dMunicipio[alfabetizacao_2022] ) )
			)
		formatString: 0.0"%"
		displayFolder: 6. Perfil dos municípios
		lineageTag: c740b665-821a-4819-a585-949ba10bb316

	measure 'Diferença de Apuração' = [Comparecimento] - ( [Votos Válidos] + [Votos Brancos] + [Votos Nulos] )
		formatString: #,0
		displayFolder: 7. Qualidade dos dados
		lineageTag: 55fccc26-5c8f-4fb1-907d-1ffc5ce5a600

	measure 'Conferência Válidos' = IF ( [Votos Todos os Candidatos] = [Votos Válidos], "✔ confere", "✖ diferente" )
		displayFolder: 7. Qualidade dos dados
		lineageTag: 5c3af3b0-a6ca-4658-b922-fa7c8f256f63

	measure 'Cor do Partido' =
			VAR partido =
			    CONCATENATEX ( TOPN ( 1, VALUES ( dCandidato[partido_atual] ), [Votos] ), dCandidato[partido_atual], " / " )
			RETURN
			    COALESCE ( LOOKUPVALUE ( PartidoCores[cor], PartidoCores[sg_partido], partido ), "#9AA3AE" )
		displayFolder: 8. Cores e textos
		lineageTag: 7d6d6fa1-522f-4dfd-8058-e69bd4be9c80

	measure 'Cor do Partido Vencedor' =
			VAR partido = [Partido Vencedor]
			RETURN
			    IF (
			        NOT ISBLANK ( partido ),
			        COALESCE ( LOOKUPVALUE ( PartidoCores[cor], PartidoCores[sg_partido], partido ), "#9AA3AE" )
			    )
		displayFolder: 8. Cores e textos
		lineageTag: 1048234d-7982-4bac-8b93-ba9b53c50f9f

	measure 'Cor Mudança' = SWITCH ( [Mudou Partido Vencedor], 1, "#E3B505", 0, "#C9CED6" )
		displayFolder: 8. Cores e textos
		lineageTag: 7f57176c-b8a2-4c10-a4c6-9e0e76469e9b

	measure 'Cor Virada' = SWITCH ( [Virou no 2º Turno], 1, "#E3B505", 0, "#C9CED6" )
		displayFolder: 8. Cores e textos
		lineageTag: 03ad2f5e-68bf-431c-9774-fc44104afa12

	measure 'Título Eleição' =
			VAR rotulo = SELECTEDVALUE ( dTurno[rotulo_turno], "Selecione uma eleição e um turno" )
			RETURN
			    "Eleição presidencial · " & rotulo
		displayFolder: 8. Cores e textos
		lineageTag: c9d04c25-d623-41db-beb6-185c8fcfc7e0

	measure 'Resumo Vencedor' =
			VAR nome = [Vencedor]
			VAR pct = [% do Vencedor]
			RETURN
			    IF (
			        NOT ISBLANK ( nome ),
			        nome & " teve " & FORMAT ( pct, "0.00%" ) & " dos votos válidos"
			    )
		displayFolder: 8. Cores e textos
		lineageTag: 5b4ab33d-7dba-4c60-a6aa-7de3accd40b3

	measure '% Abstenção Nacional' =
			CALCULATE (
			    [% Abstenção],
			    REMOVEFILTERS ( dMunicipio[sg_uf] )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1. Eleitorado
		lineageTag: 0ed62b88-7273-4815-a767-f7269228026e

	partition '_Medidas' = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

