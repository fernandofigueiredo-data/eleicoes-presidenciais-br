	measure 'Votos Todos os Candidatos' = CALCULATE ( [Votos], REMOVEFILTERS ( dCandidato ) )
		formatString: #,0
		displayFolder: 2. Votos
		lineageTag: 20c7aa5a-ea03-4a52-95a7-0b9d23c9aa58

	measure '% Votos Válidos' = DIVIDE ( [Votos], [Votos Todos os Candidatos] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2. Votos
		lineageTag: b1cd110e-6f3d-4f6c-b0a1-4b1229bcb629

	measure 'Posição' =
			IF (
			    NOT ISBLANK ( [Votos] ),
			    RANKX ( ALLSELECTED ( dCandidato[nm_urna] ), [Votos],, DESC, DENSE ))
		formatString: 0
		displayFolder: 2. Votos
		lineageTag: 85dbcf23-609c-4aa7-a063-0b1cea9085a8

	measure 'Vencedor' =
			VAR primeiro =
			    TOPN ( 1, VALUES ( dCandidato[nm_urna] ), [Votos] )
			RETURN
			    IF ( [Votos Todos os Candidatos] > 0, CONCATENATEX ( primeiro, dCandidato[nm_urna], " / " ) )
		displayFolder: 3. Vencedores
		lineageTag: 8144b8d0-ec10-4ffb-9a09-cd30e6fafca2

	measure 'Partido Vencedor' =
			VAR primeiro =
			    TOPN ( 1, VALUES ( dCandidato[partido_atual] ), [Votos] )
			RETURN
			    IF ( [Votos Todos os Candidatos] > 0, CONCATENATEX ( primeiro, dCandidato[partido_atual], " / " ) )
		displayFolder: 3. Vencedores
		lineageTag: f796b2eb-46ed-4c1a-881e-219dade62a06

	measure '% do Vencedor' =
			VAR primeiro =
			    TOPN ( 1, VALUES ( dCandidato[chave_candidato] ), [Votos] )
			RETURN
			    DIVIDE ( MAXX ( primeiro, [Votos] ), [Votos Todos os Candidatos] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Vencedores
		lineageTag: 72a09c51-e71f-4dd3-974b-a58ab19561c8

	measure 'Margem de Vitória' =
			VAR doisPrimeiros =
			    TOPN ( 2, VALUES ( dCandidato[chave_candidato] ), [Votos] )
			VAR primeiro = MAXX ( doisPrimeiros, [Votos] )
			VAR segundo = MINX ( doisPrimeiros, [Votos] )
			RETURN
			    IF (
			        COUNTROWS ( doisPrimeiros ) >= 2,
			        DIVIDE ( primeiro - segundo, [Votos Todos os Candidatos] )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Vencedores
		lineageTag: 400c4db5-6abb-47e9-86d6-ec5bc55841d5

	measure 'Municípios Vencidos' =
			COUNTROWS (
			    FILTER (
			        VALUES ( dMunicipio[cd_municipio_tse] ),
			        VAR votosCandidato = [Votos]
			        VAR maiorVotacao =
			            CALCULATE (
			                MAXX ( VALUES ( dCandidato[chave_candidato] ), [Votos] ),
			                REMOVEFILTERS ( dCandidato )
			            )
			        RETURN
			            votosCandidato > 0 && votosCandidato = maiorVotacao
			    )
			)
		formatString: #,0
		displayFolder: 3. Vencedores
		lineageTag: 55b724fa-e325-4c41-a061-9df664aaf092

	measure '% Municípios Vencidos' =
			DIVIDE (
			    [Municípios Vencidos],
			    CALCULATE ( DISTINCTCOUNT ( fVotos[cd_municipio_tse] ), REMOVEFILTERS ( dCandidato ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 3. Vencedores
		lineageTag: 72167779-7626-47ac-a8c4-82c69100f356

	measure 'Ano Selecionado' = SELECTEDVALUE ( dTurno[ano] )
		formatString: 0
		displayFolder: 4. Comparação entre eleições
		lineageTag: 2629fd66-a284-4ee4-9d0a-45d4c5ff785d

	measure 'Partido Vencedor 1º Turno' =
			VAR anoAtual = [Ano Selecionado]
			RETURN
			    CALCULATE (
			        [Partido Vencedor],
			        REMOVEFILTERS ( dTurno ),
			        dTurno[ano] = anoAtual,
			        dTurno[nr_turno] = 1
			    )
		displayFolder: 4. Comparação entre eleições
		lineageTag: d6db1280-cee9-4776-a2d2-c9bfb85f4a6f

	measure 'Partido Vencedor 1º Turno Anterior' =
			VAR anoAnterior = [Ano Selecionado] - 4
			RETURN
			    CALCULATE (
			        [Partido Vencedor],
			        REMOVEFILTERS ( dTurno ),
			        dTurno[ano] = anoAnterior,
			        dTurno[nr_turno] = 1
			    )
		displayFolder: 4. Comparação entre eleições
		lineageTag: b1a12443-7747-4d1c-b91d-23f4fdfcf526

	measure 'Mudou Partido Vencedor' =
			VAR atual = [Partido Vencedor 1º Turno]
			VAR anterior = [Partido Vencedor 1º Turno Anterior]
			-- Bolsonaro concorreu pelo PSL em 2018 e pelo PL em 2022/2026: tratamos PSL e PL como o mesmo
			-- campo para que a troca de sigla do mesmo candidato não conte como mudança de vencedor.
			VAR atualComparavel = SUBSTITUTE ( atual, "PSL", "PL" )
			VAR anteriorComparavel = SUBSTITUTE ( anterior, "PSL", "PL" )
			RETURN
			    IF (
			        NOT ISBLANK ( atual ) && NOT ISBLANK ( anterior ),
			        IF ( atualComparavel <> anteriorComparavel, 1, 0 )
			    )
		formatString: 0
		displayFolder: 4. Comparação entre eleições
		lineageTag: df69899e-f2c5-4f40-8ca9-ee9e3c134468

	measure 'Municípios que Mudaram' = SUMX ( VALUES ( dMunicipio[cd_municipio_tse] ), [Mudou Partido Vencedor] )
		formatString: #,0
		displayFolder: 4. Comparação entre eleições
		lineageTag: 9c8f9820-d498-4495-8216-b7e92b04b372

	measure '% Municípios que Mudaram' =
			DIVIDE (
			    [Municípios que Mudaram],
			    SUMX (
			        VALUES ( dMunicipio[cd_municipio_tse] ),
			        IF ( NOT ISBLANK ( [Mudou Partido Vencedor] ), 1 )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 4. Comparação entre eleições
		lineageTag: 936fb040-f6d7-406b-a5a5-b7a0211a89e8

	measure '% Votos Válidos Eleição Anterior' =
			VAR anoAnterior = [Ano Selecionado] - 4
			VAR turnoAtual = SELECTEDVALUE ( dTurno[nr_turno] )
			-- Bolsonaro concorreu pelo PSL em 2018 e pelo PL em 2022: na comparação 2022 x 2018,
			-- o PL usa o resultado do PSL, como nos cards, no mapa e na tabela da página.
			VAR partidoSelecionado = SELECTEDVALUE ( dCandidato[partido_atual] )
			VAR usarPSL = partidoSelecionado = "PL" && anoAnterior = 2018
			RETURN
			    IF (
			        usarPSL,
			        CALCULATE (
			            [% Votos Válidos],
			            REMOVEFILTERS ( dTurno ),
			            dTurno[ano] = anoAnterior,
			            dTurno[nr_turno] = turnoAtual,
			            dCandidato[partido_atual] = "PSL"
			        ),
			        CALCULATE (
			            [% Votos Válidos],
			            REMOVEFILTERS ( dTurno ),
			            dTurno[ano] = anoAnterior,
			            dTurno[nr_turno] = turnoAtual
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 4. Comparação entre eleições
		lineageTag: 8f08ae50-afeb-4d45-bd1d-30f47766a21d

	measure 'Variação p.p.' =
			VAR atual = [% Votos Válidos]
			VAR anterior = [% Votos Válidos Eleição Anterior]
			RETURN
			    IF ( NOT ISBLANK ( atual ) && NOT ISBLANK ( anterior ), ( atual - anterior ) * 100 )
		formatString: +0.0" p.p.";-0.0" p.p.";0.0" p.p."
		displayFolder: 4. Comparação entre eleições
		lineageTag: 0646a153-0ffa-4f8a-a8a2-6f352cdc37f8

	measure '% Abstenção Eleição Anterior' =
			VAR anoAnterior = [Ano Selecionado] - 4
			VAR turnoAtual = SELECTEDVALUE ( dTurno[nr_turno] )
			RETURN
			    CALCULATE (
			        [% Abstenção],
			        REMOVEFILTERS ( dTurno ),
			        dTurno[ano] = anoAnterior,
			        dTurno[nr_turno] = turnoAtual
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 4. Comparação entre eleições
		lineageTag: 353ce57b-ba81-4477-ba8e-8f763136ed20

	measure 'Variação Abstenção p.p.' =
			VAR atual = [% Abstenção]
			VAR anterior = [% Abstenção Eleição Anterior]
			RETURN
			    IF ( NOT ISBLANK ( anterior ), ( atual - anterior ) * 100 )
		formatString: +0.0" p.p.";-0.0" p.p.";0.0" p.p."
		displayFolder: 4. Comparação entre eleições
		lineageTag: 092dc339-4d9e-445c-8b33-bab6c6f75b73

	measure 'Vencedor 1º Turno' =
